{
  "name": "{{projectName}}",
  "version": "1.0.0",
  "description": "My Moleculer-based microservice",
  "scripts": {
    "dev": "moleculer-runner --repl --hot service.js",
    "start": "moleculer-runner service.js",
    "ci": "jest --watch",
    "test": "jest --coverage"{{#lint}},
    "lint": "eslint service.js"{{/lint}}
  },
  "keywords": [
    "microservices",
    "moleculer"
  ],
  "author": "",
  "devDependencies": {
    {{#lint}}
    "@eslint/js": "^9.24.0",
    "eslint": "^9.24.0",
    {{/lint}}
    "jest": "^30.3.0",
    "moleculer-repl": "^0.8.0"
  },
  "dependencies": {
    {{#if_eq transporter "NATS"}}
    "nats": "^2.29.3",
    {{/if_eq}}
    {{#if_eq transporter "MQTT"}}
    "mqtt": "^5.15.1",
    {{/if_eq}}
    {{#if_eq transporter "AMQP"}}
    "amqplib": "^1.0.2",
    {{/if_eq}}
    {{#if_eq transporter "Kafka"}}
    "@platformatic/kafka": "^1.31.0",
    {{/if_eq}}
    {{#redis}}
    "ioredis": "^5.10.1",
    {{/redis}}
    "moleculer": "^0.15.0"
  },
  "engines": {
    "node": ">= 22.x.x"
  }{{#jest}},
  "jest": {
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "rootDir": "./",
    "roots": [
      "./test"
    ]
  }{{/jest}}
}
