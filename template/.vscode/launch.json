{
	"version": "0.2.0",
	"configurations": [

		{
			"type": "node",
			"request": "launch",
			"name": "Debug",
			"program": "${workspaceFolder}/node_modules/moleculer/bin/moleculer-runner.js",
			"cwd": "${workspaceFolder}",
			"args": [
				"service.js"
			]
		},
		{
			"type": "node",
			"request": "launch",
			"name": "Jest",
			"program": "${workspaceFolder}/node_modules/jest/bin/jest.js",
			"args": ["--runInBand"],
			"cwd": "${workspaceFolder}",
			"runtimeArgs": [
				"--nolazy"
			]
		}
	]
}
