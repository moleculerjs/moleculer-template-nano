NAMESPACE=
LOGGER=true
LOGLEVEL=info
{{#if_eq transporter "NATS"}}TRANSPORTER=nats://nats:4222{{/if_eq}}{{#if_eq transporter "Redis"}}TRANSPORTER=redis://redis:6379{{/if_eq}}{{#if_eq transporter "MQTT"}}TRANSPORTER=mqtt://mqtt:1883{{/if_eq}}{{#if_eq transporter "AMQP"}}TRANSPORTER=amqp://rabbitmq:5672{{/if_eq}}{{#if_eq transporter "Kafka"}}TRANSPORTER=kafka://kafka:9092{{/if_eq}}{{#if_eq transporter "TCP"}}TRANSPORTER=TCP{{/if_eq}}
{{#if needCacher}}{{#if_eq cacher "Redis"}}CACHER=redis://redis:6379{{/if_eq}}{{#if_eq cacher "Memory"}}CACHER=Memory{{/if_eq}}{{/if}}{{#unless needCacher}}CACHER={{/unless}}
